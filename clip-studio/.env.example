CLIP_DOMAIN=clips.example.com
CLIP_USERNAME=creator
# Use a unique password with at least 16 characters. Do not commit .env.
CLIP_PASSWORD=

# Optional. Keys can also be set in the AI tab in the editor.
GROQ_API_KEY=
CLIP_GROQ_MODEL=openai/gpt-oss-20b
CLIP_MAX_UPLOAD_MB=512
CLIP_DATA_BUDGET_MB=2048
CLIP_MIN_FREE_MB=512
CLIP_RETENTION_DAYS=7
CLIP_AI_DAILY_LIMIT=10
OPENAI_API_KEY=
GEMINI_API_KEY=
CLIP_OPENAI_MODEL=gpt-4.1-mini
CLIP_GEMINI_MODEL=gemini-3.8-flash
# Private Compose host port; avoids EduKit's 8000.
CLIP_HTTP_PORT=18080
